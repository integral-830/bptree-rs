use crate::{error::BPlusTreeError, slotted_page::PAGE_SIZE, BPlusNode};

pub const MAGIC: [u8; 4] = *b"BTR4";
pub const FORMAT_VERSION: u8 = 1;
pub const HEADER_SIZE: usize = 6; // 4 bytes MAGIC + 1 byte FORMAT + 1 byte Node variant

pub fn encode(node: &BPlusNode) -> Result<[u8; PAGE_SIZE], BPlusTreeError> {
    let node_size = node.encoded_len()?;
    if node_size > PAGE_SIZE {
        return Err(BPlusTreeError::NodeTooLarge {
            reason: String::from("Node size is bigger than PAGE_SIZE: 4096"),
        });
    }
    let mut buffer = [0u8; PAGE_SIZE];
    buffer[0..4].copy_from_slice(&MAGIC); // MAGIC
    buffer[4..5].copy_from_slice(&FORMAT_VERSION.to_le_bytes()); //FORMAT
    match node {
        BPlusNode::Leaf {
            keys,
            values,
            next_leaf,
        } => {
            buffer[5..6].copy_from_slice(&1u8.to_le_bytes()); //variant
            let key_count = u16::try_from(keys.len())?;
            buffer[6..8].copy_from_slice(&key_count.to_le_bytes()); // key_count
            let mut cursor: usize = 8;
            if let Some(next_leaf) = next_leaf {
                buffer[8..9].copy_from_slice(&1u8.to_le_bytes()); // next_leaf
                buffer[9..17].copy_from_slice(&next_leaf.get().to_le_bytes()); // next_leaf_data
                cursor = 17;
            } else {
                buffer[8..9].copy_from_slice(&0u8.to_le_bytes());
                cursor = 9;
            }
            for (key, val) in keys.iter().zip(values.iter()) {
                let key_len = u16::try_from(key.as_bytes().len())?;
                buffer[cursor..cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(&key_len.to_le_bytes()); // key_len
                cursor = cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?;
                buffer[cursor
                    ..cursor
                        .checked_add(key_len as usize)
                        .ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(key.as_bytes()); // key_bytes
                cursor = cursor
                    .checked_add(key_len as usize)
                    .ok_or(BPlusTreeError::SizeOverflow)?;
                buffer[cursor..cursor.checked_add(8).ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(&val.page_id().get().to_le_bytes()); // page_id
                cursor = cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?;
                buffer[cursor..cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(&val.slot_id().to_le_bytes()); // slot_id
                cursor = cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?;
            }
            Ok(buffer)
        }
        BPlusNode::Internal { keys, children } => {
            buffer[5..6].copy_from_slice(&0u8.to_le_bytes()); //variant
            let key_count = u16::try_from(keys.len())?;
            buffer[6..8].copy_from_slice(&key_count.to_le_bytes()); // key_count
            let mut cursor: usize = 8;
            for key in keys {
                let key_len = u16::try_from(key.as_bytes().len())?;
                buffer[cursor..cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(&key_len.to_le_bytes()); // key_len
                cursor = cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?;
                buffer[cursor
                    ..cursor
                        .checked_add(key_len as usize)
                        .ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(key.as_bytes()); // key_bytes
                cursor = cursor
                    .checked_add(key_len as usize)
                    .ok_or(BPlusTreeError::SizeOverflow)?;
            }
            buffer[cursor..cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?]
                .copy_from_slice(
                    &(key_count
                        .checked_add(1)
                        .ok_or(BPlusTreeError::SizeOverflow)?)
                    .to_le_bytes(),
                ); // children_count
            cursor = cursor.checked_add(2).ok_or(BPlusTreeError::SizeOverflow)?;
            for child in children {
                let child = child.get();
                buffer[cursor..cursor.checked_add(8).ok_or(BPlusTreeError::SizeOverflow)?]
                    .copy_from_slice(&child.to_le_bytes()); // child
                cursor = cursor.checked_add(8).ok_or(BPlusTreeError::SizeOverflow)?;
            }
            Ok(buffer)
        }
    }
}

#[cfg(test)]
mod node_codec_encode_tests {
    use super::*;
    use crate::{Key, PageId, RecordId};

    fn key(bytes: &[u8]) -> Key {
        Key::new(bytes.to_vec())
    }

    fn page_id(id: u64) -> PageId {
        PageId::new(id)
    }

    fn record_id(page: u64, slot: u16) -> RecordId {
        RecordId::new(page_id(page), slot)
    }

    fn read_u16(data: &[u8]) -> u16 {
        u16::from_le_bytes(data.try_into().unwrap())
    }

    fn read_u64(data: &[u8]) -> u64 {
        u64::from_le_bytes(data.try_into().unwrap())
    }

    #[test]
    fn encode_empty_leaf() {
        let node = BPlusNode::Leaf {
            keys: vec![],
            values: vec![],
            next_leaf: None,
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(&encoded[0..4], &MAGIC);
        assert_eq!(encoded[4], FORMAT_VERSION);
        assert_eq!(encoded[5], 1);
        assert_eq!(read_u16(&encoded[6..8]), 0);
        assert_eq!(encoded[8], 0);
        assert_eq!(node.encoded_len().unwrap(), 9);
    }

    #[test]
    fn encode_leaf_with_next_leaf() {
        let node = BPlusNode::Leaf {
            keys: vec![],
            values: vec![],
            next_leaf: Some(page_id(0x0102_0304_0506_0708)),
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(encoded[8], 1);
        assert_eq!(read_u64(&encoded[9..17]), 0x0102_0304_0506_0708);
        assert_eq!(node.encoded_len().unwrap(), 17);
    }

    #[test]
    fn encode_leaf_with_one_entry() {
        let node = BPlusNode::Leaf {
            keys: vec![key(b"apple")],
            values: vec![record_id(42, 7)],
            next_leaf: None,
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(read_u16(&encoded[6..8]), 1);
        assert_eq!(encoded[8], 0);

        assert_eq!(read_u16(&encoded[9..11]), 5);
        assert_eq!(&encoded[11..16], b"apple");

        assert_eq!(read_u64(&encoded[16..24]), 42);
        assert_eq!(read_u16(&encoded[24..26]), 7);

        assert_eq!(node.encoded_len().unwrap(), 26);
    }

    #[test]
    fn encode_leaf_with_multiple_entries() {
        let node = BPlusNode::Leaf {
            keys: vec![key(b"a"), key(b"bb"), key(b"ccc")],
            values: vec![record_id(10, 1), record_id(20, 2), record_id(30, 3)],
            next_leaf: None,
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(read_u16(&encoded[6..8]), 3);

        let mut cursor = 9;

        for (expected_key, expected_page, expected_slot) in [
            (b"a".as_slice(), 10u64, 1u16),
            (b"bb".as_slice(), 20u64, 2u16),
            (b"ccc".as_slice(), 30u64, 3u16),
        ] {
            let key_len = read_u16(&encoded[cursor..cursor + 2]) as usize;
            cursor += 2;

            assert_eq!(key_len, expected_key.len());
            assert_eq!(&encoded[cursor..cursor + key_len], expected_key);
            cursor += key_len;

            assert_eq!(read_u64(&encoded[cursor..cursor + 8]), expected_page);
            cursor += 8;

            assert_eq!(read_u16(&encoded[cursor..cursor + 2]), expected_slot);
            cursor += 2;
        }

        assert_eq!(cursor, node.encoded_len().unwrap());
    }

    #[test]
    fn encode_leaf_with_empty_key() {
        let node = BPlusNode::Leaf {
            keys: vec![key(b"")],
            values: vec![record_id(5, 0)],
            next_leaf: None,
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(read_u16(&encoded[9..11]), 0);
        assert_eq!(read_u64(&encoded[11..19]), 5);
        assert_eq!(read_u16(&encoded[19..21]), 0);

        assert_eq!(node.encoded_len().unwrap(), 21);
    }

    #[test]
    fn encode_internal_with_zero_keys_and_one_child() {
        let node = BPlusNode::Internal {
            keys: vec![],
            children: vec![page_id(123)],
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(encoded[5], 0);
        assert_eq!(read_u16(&encoded[6..8]), 0);

        assert_eq!(read_u16(&encoded[8..10]), 1);
        assert_eq!(read_u64(&encoded[10..18]), 123);

        assert_eq!(node.encoded_len().unwrap(), 18);
    }

    #[test]
    fn encode_internal_with_multiple_keys_and_children() {
        let node = BPlusNode::Internal {
            keys: vec![key(b"alpha"), key(b"beta")],
            children: vec![page_id(100), page_id(200), page_id(300)],
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(encoded[5], 0);
        assert_eq!(read_u16(&encoded[6..8]), 2);

        let mut cursor = 8;

        for expected_key in [b"alpha".as_slice(), b"beta".as_slice()] {
            let key_len = read_u16(&encoded[cursor..cursor + 2]) as usize;
            cursor += 2;

            assert_eq!(key_len, expected_key.len());
            assert_eq!(&encoded[cursor..cursor + key_len], expected_key);
            cursor += key_len;
        }

        assert_eq!(read_u16(&encoded[cursor..cursor + 2]), 3);
        cursor += 2;

        for expected_child in [100u64, 200, 300] {
            assert_eq!(read_u64(&encoded[cursor..cursor + 8]), expected_child);
            cursor += 8;
        }

        assert_eq!(cursor, node.encoded_len().unwrap());
    }

    #[test]
    fn encode_preserves_large_u64_page_ids() {
        let large_page_id = u64::MAX - 1;

        let node = BPlusNode::Leaf {
            keys: vec![key(b"k")],
            values: vec![record_id(large_page_id, u16::MAX)],
            next_leaf: Some(page_id(large_page_id)),
        };

        let encoded = encode(&node).unwrap();

        assert_eq!(read_u64(&encoded[9..17]), large_page_id);

        let record_page_offset = 17 + 2 + 1;
        assert_eq!(
            read_u64(&encoded[record_page_offset..record_page_offset + 8]),
            large_page_id
        );

        assert_eq!(
            read_u16(&encoded[record_page_offset + 8..record_page_offset + 10]),
            u16::MAX
        );
    }

    #[test]
    fn encode_is_deterministic() {
        let node = BPlusNode::Internal {
            keys: vec![key(b"a"), key(b"b")],
            children: vec![page_id(1), page_id(2), page_id(3)],
        };

        let first = encode(&node).unwrap();
        let second = encode(&node).unwrap();

        assert_eq!(first, second);
    }

    #[test]
    fn encoded_len_matches_leaf_encoding() {
        let node = BPlusNode::Leaf {
            keys: vec![key(b"a"), key(b"bb")],
            values: vec![record_id(10, 1), record_id(20, 2)],
            next_leaf: Some(page_id(99)),
        };

        let encoded = encode(&node).unwrap();
        let expected_len = node.encoded_len().unwrap();

        assert!(encoded[expected_len..].iter().all(|byte| *byte == 0));
    }

    #[test]
    fn encoded_len_matches_internal_encoding() {
        let node = BPlusNode::Internal {
            keys: vec![key(b"alpha"), key(b"beta")],
            children: vec![page_id(1), page_id(2), page_id(3)],
        };

        let encoded = encode(&node).unwrap();
        let expected_len = node.encoded_len().unwrap();

        assert!(encoded[expected_len..].iter().all(|byte| *byte == 0));
    }

    #[test]
    fn encode_rejects_node_larger_than_page() {
        let node = BPlusNode::Leaf {
            keys: vec![key(&vec![b'x'; PAGE_SIZE])],
            values: vec![record_id(1, 1)],
            next_leaf: None,
        };

        let result = encode(&node);

        assert!(matches!(result, Err(BPlusTreeError::NodeTooLarge { .. })));
    }
}
